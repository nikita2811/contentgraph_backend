.pytest_cache/
.coverage
htmlcov/

# MyPy cache
.mypy_cache/

# Celery cache / beat schedule
celerybeat-schedule
celerybeat.pid

# Environment
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Static / media (generated at deploy time)
staticfiles/
mediafiles/
media/

# DB (if using SQLite locally)
*.sqlite3

# OS
.DS_Store
Thumbs.db